Scene: ScriptTest

Entities:
  - Entity: 1000000001
    TagComponent:
      Tag: Directional Light
    TransformComponent:
      Translation: [0, 0, 0]
      Rotation: [-0.488692194, 0.785398185, 0.0366519131]
      Scale: [1, 1, 1]
    DirectionalLightComponent:
      Color: [0.737254918, 1, 0.443137258, 1]
      Intensity: 1.5

  - Entity: 1000000002
    TagComponent:
      Tag: Volumetric Fog
    TransformComponent:
      Translation: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [10000, 150, 10000]
    VolumetricFogComponent:
      Enabled: true
      Color: [0.7, 0.75, 0.8, 1]
      Density: 0.05
      Anisotropy: 0.3
      HeightFalloff: 1
      NoiseStrength: 0.5
      NoiseScale: 0.25
      WindSpeed: 0.05

  - Entity: 1000000003
    TagComponent:
      Tag: Ground
    TransformComponent:
      Translation: [0, -0.5, 0]
      Rotation: [0, 0, 0]
      Scale: [100, 1, 100]
    CubeRendererComponent:
      Color: [1, 1, 1, 1]
      TextureWidth: 0
      TextureHeight: 0
      TextureIndex: 0
      TilingFactor: 1
    MaterialComponent:
      Albedo: [1, 1, 1, 1]
      TextureWidth: 225
      TextureHeight: 225
      TextureIndex: 0
      TexturePath: assets/textures/metal_floor.jpg
      HasGeneratedMaps: false
      NormalStrength: 1
      Metallic: 1
      Roughness: 1
      EmissionColor: [1, 1, 1, 1]
      EmissionIntensity: 0
      DisplacementScale: 0.3
    RigidBody3DComponent:
      BodyType: Static
      GravityScale: 1
      LinearDamping: 0
      AngularDamping: 0
      FixedRotationX: false
      FixedRotationY: false
      FixedRotationZ: false
    BoxCollider3DComponent:
      HalfExtents: [0.5, 0.5, 0.5]
      Offset: [0, 0, 0]
      Density: 1
      Friction: 0.5
      Restitution: 0

