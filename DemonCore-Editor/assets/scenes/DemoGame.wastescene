  - Entity: 9700000000000000023
    TagComponent:
      Tag: ShowcaseAudioListener
    TransformComponent:
      Translation: [416, 1.7, 1090]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    # Deliberately has no AudioListenerComponent.
    #
    # FindListenerEntity gives an explicit AudioListenerComponent priority over
    # the primary camera, so carrying one here pinned the ears to this static
    # marker at x=416 -- 48 m from the showcase source, beyond its
    # MaxDistance of 25 -- and ignored the player entirely. With no explicit
    # listener the ears follow the camera, which is what AudioDemo.py's
    # docstring always claimed, and the source becomes audible as the player
    # walks down the showcase row toward it.
    #
    # The entity stays as a visual marker for the showcase row; it just no
    # longer owns the listener.
  - Entity: 9700000000000000019
